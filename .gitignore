# Dependencies
node_modules/

# Build outputs (generated by vite / electron-builder)
dist/
dist-web/
dist-electron/
dist-electron-*/
dist-electron-v*/

# Local backend build artifacts (dist/backend generated by scripts/build-*.bat)
dist/backend/

# Runtime data directory (app writes here at runtime)
data/

# Python virtualenv (CI creates .venv; never commit it)
.venv/

# Local smoke / verification scripts (local only, not part of the app)
scripts/_smoke*.cjs
scripts/verify/

# Packaging temp dirs and logs
.tmp_dist_test/
__builder*.log
__build*.log
__install.log
*.log

# Env / OS
.env
.env.local
.DS_Store

# Local packaging validation reports
*.report.txt

# WorkBuddy session metadata (not part of the app)
.workbuddy/

# Python caches (compiled)
__pycache__/
*.pyc

# PyInstaller build temp
# 注意：build/icon.ico 是 electron 应用图标【源文件】，electron-builder.yml 引用它，必须保留；
# 只忽略 build/backend/（PyInstaller 生成的工作目录）与 scripts/build/。
build/backend/
scripts/build/

# Runtime / probe logs and outputs（logs/ 下是 .txt 运行日志，*.log 不覆盖）
logs/
*.tsbuildinfo
sidecar_run.err
sidecar_run.out

# 本地探测 / 验证脚本与产物（非应用一部分，不进仓库）
__asar_list.txt
__investigate.cjs
probe_akshare*.py
probe_board.py
probe_em_direct.py
scan_tdx.py
diag_pool.py
capability-matrix.json
probe_akshare_result*.json
probe_board_result.json
